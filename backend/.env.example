# Local / private defaults. For a public mock recruiter deploy see docs/DEMO_HOSTING.md:
#   MOCK_LLM=1  ENABLE_INGEST=0  CORS_ORIGINS=https://your-app.vercel.app
#   (omit GROQ_API_KEY entirely on the mock path)

GROQ_API_KEY=your_key_here
CHROMA_PATH=./chroma_db
AUDIT_DB_PATH=./audit.db
DEFAULT_COLLECTION=clinical_guidelines
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=*
MOCK_LLM=0
LOG_JSON=1
LOG_LEVEL=INFO
APP_VERSION=1.1.0
RETRIEVAL_OVERFETCH=2
RELEVANCE_FLOOR=0.2
# Set 0 on any public deploy (unauthenticated ingest otherwise)
ENABLE_INGEST=1
